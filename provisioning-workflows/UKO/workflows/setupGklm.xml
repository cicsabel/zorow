<workflow xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="schemas/workflow_v1.xsd">
    <!--  Note: The schema workflow_v1.xsd is shipped with z/OSMF. To use the schema
          to validate this XML, modify the above schema location to point to the 
          schema in z/OSMF, or copy the schema to an appropriate location.  -->

    <!--++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
    <!-- UKO Setup : Setting up for GKLM integration                          -->
    <!--++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-->

  <workflowInfo>
      <workflowID>uko_setupGklm</workflowID>
      <workflowDescription>Configure security access for IBM Guardium Key Lifecycle Manager (GKLM) integration with UKO</workflowDescription>
    <workflowVersion>1.0.0.0</workflowVersion>
      <vendor>IBM</vendor>
      <Provisioning>
          <productID>5655-EKM</productID>
          <productName>UKO</productName>
          <productVersion>V2R1+</productVersion>
          <softwareType>ukoserver</softwareType>
      </Provisioning>
  </workflowInfo>
  
  	<!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
	<!--     Include variables used by the following steps     -->
	<!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
	&variables;
  
	<atCreate name="CLIENT_ACCESS_GROUP" scope="instance" prompt="true" required="false"/>

	   <step name="defineGklmAccess">
	       <title>Define security access for GKLM</title>
	       <description>Grant access to EJB roles and APPL profile for GKLM API clients</description>
	       <runAsUser substitution="true">$!{instance-UKO_ADMIN_SECURITY}</runAsUser>
	       <approver substitution="true">$!{instance-UKO_APPROVER_SECURITY}</approver>
	       <variableValue name="CLIENT_ACCESS_GROUP" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="UKO_VAULT_ID" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="SAF_PROFILE_PREFIX" scope="instance" noPromptIfSet="false" required="false"/>
        <instructions>Executes a REXX program to access EJB roles</instructions>
        <weight>1</weight>
        <autoEnable>true</autoEnable>
        <template>
            <fileTemplate substitution="true">rexx/defineServerGklmAccess.rexx</fileTemplate>
            <submitAs maxRc="4">TSO-REXX-JCL</submitAs>
            <maxLrecl>1024</maxLrecl>
        </template>
    </step>

</workflow>
