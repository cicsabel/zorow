<step name="defineOidcCertificate">
    <title>Define OIDC certificate</title>
    <description>Create and configure OIDC provider certificate for Liberty-based servers</description>

    <step name="createOidcCertificate">
        <title>Create OIDC certificate</title>
        <description>If requested, create an OIDC provider certificate</description>
        <runAsUser substitution="true">$!{instance-UKO_ADMIN_SECURITY}</runAsUser>
        <approver substitution="true">$!{instance-UKO_APPROVER_SECURITY}</approver>
        <condition>
            <expression><![CDATA["1" == "1"]]></expression>
            <description>Always perform</description>
            <targetStateSet>
                <description>Only create the OIDC certificate if requested and different from TLS cert</description>
                <extendStateExpression>
                    <description>Skip if SERVER_CREATE_CERTIFICATES is false or OIDC cert equals TLS cert</description>
                    <expression><![CDATA[ ${instance-SERVER_CREATE_CERTIFICATES} != "true" ]]></expression>
                    <targetState>Skipped</targetState>
                </extendStateExpression>
            </targetStateSet>
        </condition>
        <variableValue name="SERVER_STC_USER" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="SERVER_CA_LABEL" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="SERVER_TLS_KEY_STORE_SERVER_CERT" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="SERVER_OIDC_PROVIDER_CERT" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="SERVER_TLS_KEY_STORE_SERVER_CERT_CN" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="SERVER_TLS_KEY_STORE_SERVER_CERT_OU" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="SERVER_TLS_KEY_STORE_SERVER_CERT_O" scope="instance" noPromptIfSet="false" required="false"/>
        <instructions>Executes a REXX program to create the OIDC provider certificate.
            Important: adjust the NOTAFTER DATE and TIME parameters and potentially also the RSA SIZE to match your environment needs.
        </instructions>
        <weight>1</weight>
        <autoEnable>true</autoEnable>
        <template>
            <fileTemplate substitution="true">rexx/defineKeyringOidcCert.rexx</fileTemplate>
            <submitAs maxRc="0">TSO-REXX-JCL</submitAs>
            <maxLrecl>1024</maxLrecl>
        </template>
    </step>

    <step name="addOidcToKeyring">
        <title>Add OIDC certificate to keyring</title>
        <description>Add OIDC certificate to key ring if it was newly created</description>
        <runAsUser substitution="true">$!{instance-UKO_ADMIN_SECURITY}</runAsUser>
        <approver substitution="true">$!{instance-UKO_APPROVER_SECURITY}</approver>
        <condition>
            <expression><![CDATA["1" == "1"]]></expression>
            <description>Always perform</description>
            <targetStateSet>
                <description>Skip if OIDC certificate was not created</description>
                <extendStateExpression>
                    <description>Skip if certificates were not created or OIDC cert equals TLS cert</description>
                    <expression><![CDATA[ ${instance-SERVER_CREATE_CERTIFICATES} != "true" ]]></expression>
                    <targetState>Skipped</targetState>
                </extendStateExpression>
            </targetStateSet>
        </condition>
        <variableValue name="SERVER_STC_USER" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="SERVER_OIDC_PROVIDER_CERT" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="SERVER_TLS_KEY_STORE_KEY_RING" scope="instance" noPromptIfSet="false" required="false"/>
        <instructions>Executes a REXX program to add the OIDC certificate to the key ring. The OIDC signing certificate contains a private key and is only added to the key ring, not the trust ring.</instructions>
        <weight>1</weight>
        <autoEnable>true</autoEnable>
        <template>
            <fileTemplate substitution="true">rexx/defineKeyringAddOidcCert.rexx</fileTemplate>
            <submitAs maxRc="0">TSO-REXX-JCL</submitAs>
            <maxLrecl>1024</maxLrecl>
        </template>
    </step>
</step>
