<?xml version="1.0" encoding="UTF-8"?>

<!-- Declare external file containing WAS variables referenced in the following steps -->
<!DOCTYPE workflow [<!ENTITY variables SYSTEM "variable_imports.xml">
                    <!ENTITY variables_cat SYSTEM "variable_imports_cat.xml">
                    <!ENTITY image_properties SYSTEM "extensions/image_properties.xml">
                    ]> 
                    
<!--
/******************************************************************************/
/* Copyright Contributors to the zOS-Workflow Project.                        */
/* SPDX-License-Identifier: Apache-2.0                                        */
/******************************************************************************/
-->
<workflow xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../workflow/schemas/workflow_v1.xsd">
    <!--  Note: The schema workflow_v1.xsd is shipped with z/OSMF. To use the schema
          to validate this XML, modify the above schema location to point to the 
          schema in z/OSMF, or copy the schema to an appropriate location.  -->

    <!--++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
    <!-- CAT: run the collection                                              -->
    <!--++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-->

  <workflowInfo>
      <workflowID>cc_Provision</workflowID>
      <workflowDescription>Run the CAT collection</workflowDescription>
    <workflowVersion>1.0.0.0</workflowVersion>
      <vendor>IBM</vendor>
      <Provisioning>
          <productID>5655-EKM</productID>
          <productName>UKO</productName>
          <productVersion>V2R1+</productVersion>
          <softwareType>ccserver</softwareType>
      </Provisioning>
  </workflowInfo>
  
  	<!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
	<!--     Include variables used by the following steps     -->
	<!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
	&variables;
	&variables_cat;

    <atCreate name="JAVA_HOME" scope="instance" prompt="true" required="false"/>
    <atCreate name="KAFKA_HOME" scope="instance" prompt="true" required="false"/>
    <atCreate name="ZOAU_HOME" scope="instance" prompt="true" required="false"/>
    <atCreate name="CAT_INSTALL_DIR" scope="instance" prompt="true" required="false"/>
    <atCreate name="CAT_USER_DIR" scope="instance" prompt="true" required="false"/>
    <atCreate name="AGENT_RUNLIB" scope="instance" prompt="true" required="false"/>
    
    <step name="runCatCollection">
        <title>Run CAT collection</title>
        <description>Run the CAT collection</description>
        <runAsUser substitution="true">$!{instance-UKO_ADMIN_SECURITY}</runAsUser>
        <approver substitution="true">$!{instance-UKO_APPROVER_SECURITY}</approver>     
        <variableValue name="JAVA_HOME" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="KAFKA_HOME" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="CAT_INSTALL_DIR" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="CAT_USER_DIR" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="ZOAU_HOME" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="AGENT_RUNLIB" scope="instance" noPromptIfSet="false" required="false"/>
        <instructions substitution="true">Submit JCL to collect</instructions>
        <weight>5</weight>
        <autoEnable>true</autoEnable>
        <template>
           <fileTemplate substitution="true">jcl/run-cat-collection.jcl</fileTemplate>
           <submitAs>JCL</submitAs>
           <maxLrecl>80</maxLrecl>
        </template>
    </step>

</workflow>