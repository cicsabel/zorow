    <!-- UKO Provisioning : Provision a new server                   -->
    <!--++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-->

  <workflowInfo>
      <workflowID>uko_Initialize</workflowID>
      <workflowDescription>Initialize the key hierarchy</workflowDescription>
    <workflowVersion>1.0.0.0</workflowVersion>
        <!-- Build timestamp 2021.05.09.21.03.24 -->
      <vendor>IBM</vendor>
      <Provisioning>
          <productID>5655-EKM</productID>
          <productName>UKO</productName>
          <productVersion>V2R1+</productVersion>
          <softwareType>ukoserver</softwareType>
      </Provisioning>
  </workflowInfo>
  
  	<!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
	<!--     Include variables used by the following steps     -->
	<!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
	&variables;
	<!-- <atCreate name="UKO_ADMIN_SERVER" scope="instance" prompt="true" required="false"/> -->
	<!-- <atCreate name="AGENT_STC_NAME" scope="instance" prompt="true" required="false"/> -->

    <step name="initializeKeyHierarchy" optional="false">
        <title>Initialize the Key hierarchy</title>
        <description>Initialize Settings: identity, integrity, secrets, recovery key and keks</description>
        <runAsUser substitution="true">$!{instance-UKO_ADMIN_SERVER}</runAsUser>
        <approver substitution="true">$!{instance-UKO_APPROVER_SERVER}</approver>
        <variableValue name="SERVER_PORT_TLS" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="KEY_PREFIX" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="SERVER_VERSION" scope="instance" noPromptIfSet="false" required="false"/>
        <instructions>Execute the script to initialize the key hierarchy</instructions>
        <weight>1</weight>
        <autoEnable>true</autoEnable>
        <template>
            <fileTemplate substitution="true">scripts/initializeKeyHierarchy.sh</fileTemplate>
            <submitAs>shell-JCL</submitAs>
            <maxLrecl>2048</maxLrecl>
        </template>
    </step>

