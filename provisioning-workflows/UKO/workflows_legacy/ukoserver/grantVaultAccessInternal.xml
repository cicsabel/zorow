    <step name="vaultAccess">
        <title>UKO access scripts</title>
        <description>Grant access to the UKO roles and prepare cleanup</description>
    
        <step name="vaultCleanup">
            <title>Create vault cleanup scripts</title>
            <description>Prepare cleanup scripts for deprovisioning</description>

            <step name="addVaultToLogfile">
                <title>Add vault id to logfile</title>
                <description>Submit script to add the vault id to the log file for deprovision cleanup</description>
                <runAsUser substitution="true">$!{instance-UKO_ADMIN_SECURITY}</runAsUser>
                <approver substitution="true">$!{instance-UKO_APPROVER_SECURITY}</approver>
                <condition>
                    <expression><![CDATA["1" == "1"]]></expression>
                    <description>Should the step be executed, based on the UKO_VAULT_ID setting</description>
                    <targetStateSet>
                        <description/>
                        <extendStateExpression>
                            <description>Skip if SAF_PROFILE_PREFIX == "EKMFWEB"</description>
                            <expression><![CDATA[ ${instance-SAF_PROFILE_PREFIX} == "EKMFWEB"]]></expression>
                            <targetState>Skipped</targetState>
                        </extendStateExpression>
                        <extendStateExpression>
                            <description>Skip if UKO_VAULT_ID == ekmfwebv2</description>
                            <expression><![CDATA[ ${instance-UKO_VAULT_ID} == "ekmfwebv2"]]></expression>
                            <targetState>Skipped</targetState>
                        </extendStateExpression>
                    </targetStateSet>
                </condition>
                <instructions substitution="true">Submit shell script to execute step</instructions>
                <weight>1</weight>
                <autoEnable>true</autoEnable>
                <template>
                    <inlineTemplate substitution="true">
                        #if(${instance-UKO_ADMIN_SECURITY} &amp;&amp; ${instance-UKO_ADMIN_SECURITY} != "")
                            userid=${instance-UKO_ADMIN_SECURITY}
                        #else
                            userid=${_step-stepOwnerUpper}
                        #end   

                        echo "adding vault id to log file in ${userid}'s home directory"

                        if [ -d "/u/${userid}" ]  
                        then
                            echo "${instance-UKO_VAULT_ID}\n" >> /u/${userid}/${instance-SERVER_STC_NAME}-vaults.log
                            chmod 600 /u/${userid}/${instance-SERVER_STC_NAME}-vaults.log
                        else
                            useridLC=$(echo "${userid}" | tr '[:upper:]' '[:lower:]')
                            echo "${instance-UKO_VAULT_ID}\n" >> /u/${useridLC}/${instance-SERVER_STC_NAME}-vaults.log
                            chmod 600 /u/${useridLC}/${instance-SERVER_STC_NAME}-vaults.log
                        fi 
                        
                    </inlineTemplate>
                    <submitAs>shell-JCL</submitAs>
                </template>
            </step>
                    
            <step name="copyRoleAccessVaultDeletionScriptTemplate">
