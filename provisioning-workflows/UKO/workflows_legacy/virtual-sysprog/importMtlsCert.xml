/******************************************************************************/
-->
<workflow xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../workflow/schemas/workflow_v1.xsd">
    <!--  Note: The schema workflow_v1.xsd is shipped with z/OSMF. To use the schema
          to validate this XML, modify the above schema location to point to the 
          schema in z/OSMF, or copy the schema to an appropriate location.  -->

    <!--++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
    <!-- UKO Provisioning : Provision a new server                   -->
    <!--++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-->

  <workflowInfo>
      <workflowID>createMtlsCert</workflowID>
      <workflowDescription>Create mTLS certificate for a certain user</workflowDescription>
    <workflowVersion>1.0.0.0</workflowVersion>
      <vendor>IBM</vendor>
      <Provisioning>
          <productID>5655-EKM</productID>
          <productName>UKO</productName>
          <productVersion>V2R1+</productVersion>
          <softwareType>Certificate</softwareType>
      </Provisioning>
  </workflowInfo>
  	<!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
	<!--     Include variables used by the following steps     -->
	<!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
	&variables;
    <variable name="MTLS_CERT_FILE" visibility="public">  
    <label>MTLS certificate file</label>
    <abstract>MTLS certificate file in USS</abstract>
    <description>Specify the MTLS certificate p12 file to be imported from USS. 
        Upload it from your local machine using scp, for example: 
        scp ./mtls-client.p12 your_user_id@winmvs4s.hursley.ibm.com:/u/your_user_id/mtls
    </description>
    <category>String Variables</category>
    <string>
        <!-- Path validation, has to start with slash, may contain slashes, must not end with slash or whitespace -->
        <regularExpression>^\/([A-z0-9-_+\.]+\/)*([A-z0-9-_+\.])*[^\/\s]$</regularExpression>
    </string>
    </variable>

	<!-- <atCreate name="MTLS_USER" scope="instance" required="true" prompt="true" /> -->
	<atCreate name="MTLS_HLQ" scope="instance" required="false" prompt="true" />
	<atCreate name="MTLS_CERT_FILE" scope="instance" required="false" prompt="true" />
	<atCreate name="MTLS_EXPORT_PASSWORD" scope="instance" required="false" prompt="true" />


    <step name="setVariables" optional="false">
        <title>Set Variables</title>
        <description>Update property to set the certificat location as variable</description>
        <runAsUser substitution="true">$!{instance-UKO_ADMIN_SECURITY}</runAsUser>
        <approver substitution="true">$!{instance-UKO_APPROVER_SECURITY}</approver>
        <variableValue name="MTLS_USER" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="MTLS_HLQ" scope="instance" noPromptIfSet="false" required="false"/>
        <instructions substitution="true">Submit shell script to execute step</instructions>
        <weight>1</weight>
        <autoEnable>true</autoEnable>
        <template>
            <inlineTemplate substitution="true">
                # Create a properties file to populate instance variables with useful user information
                # This is read by the output element in the workflow step.
                echo "MTLS_USER ${_step-stepOwnerUpper}" > ${instance-TEMP_DIR}/zosmf-cert-${_workflow-softwareServiceInstanceName}.properties
                echo "MTLS_LOCATION ${instance-MTLS_HLQ}.${_step-stepOwnerUpper}.MTLS" >> ${instance-TEMP_DIR}/zosmf-cert-${_workflow-softwareServiceInstanceName}.properties
                chmod 644 ${instance-TEMP_DIR}/zosmf-cert-${_workflow-softwareServiceInstanceName}.properties
            </inlineTemplate>
            <submitAs>shell-JCL</submitAs>
            <output substitution="true" needResolveConflicts="false">${instance-TEMP_DIR}/zosmf-cert-${_workflow-softwareServiceInstanceName}.properties</output>
        </template>
    </step>

    <step name="reallocateDataset">
        <title>(Re)allocate import dataset</title>
        <description>create a certificate for the user connecting via mTLS</description>
        <runAsUser substitution="true">$!{instance-UKO_ADMIN_SECURITY}</runAsUser>
        <approver substitution="true">$!{instance-UKO_APPROVER_SECURITY}</approver>
        <instructions substitution="true">Submit rexx exec to execute step</instructions>
        <weight>1</weight>
        <autoEnable>true</autoEnable>
        <template>
            <fileTemplate substitution="true">jcl/reallocate-dataset.jcl</fileTemplate>
            <submitAs maxRc="0">JCL</submitAs>
            <maxLrecl>80</maxLrecl>
        </template>
    </step>

    <step name="copyCertificateToDataset">
        <title>Copy certificate to dataset</title>
        <description>Copy the p12 certificate to the allocated dataset</description>
        <runAsUser substitution="true">$!{instance-UKO_ADMIN_SERVER}</runAsUser>
        <approver substitution="true">$!{instance-UKO_APPROVER_SERVER}</approver>
        <variableValue name="MTLS_CERT_FILE" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="MTLS_LOCATION" scope="instance" noPromptIfSet="false" required="false"/>
        <instructions substitution="true">Submit shell script to execute step</instructions>
        <weight>1</weight>
        <autoEnable>true</autoEnable>
        <template>
            <inlineTemplate substitution="true">
                echo "copying ${instance-MTLS_CERT_FILE} to ${instance-MTLS_LOCATION}"
                cp ${instance-MTLS_CERT_FILE} "//'${instance-MTLS_LOCATION}'" 

            </inlineTemplate>
            <submitAs>shell-JCL</submitAs>
        </template>
    </step>

    <step name="importCertificate">
        <title>Import certificate</title>
        <description>create a certificate for the user connecting via mTLS</description>
        <runAsUser substitution="true">$!{instance-UKO_ADMIN_SECURITY}</runAsUser>
        <approver substitution="true">$!{instance-UKO_APPROVER_SECURITY}</approver>
        <variableValue name="MTLS_USER" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="MTLS_EXPORT_PASSWORD" scope="instance" noPromptIfSet="false" required="false"/>
        <variableValue name="MTLS_HLQ" scope="instance" noPromptIfSet="false" required="false"/>
        <instructions substitution="true">Submit rexx exec to execute step</instructions>
        <weight>1</weight>
        <autoEnable>true</autoEnable>
        <template>
            <fileTemplate substitution="true">extensions/importMtlsCert.rexx</fileTemplate>
            <submitAs maxRc="0">TSO-REXX-JCL</submitAs>
            <maxLrecl>1024</maxLrecl>
        </template>
    </step>


    <step name="removeTempDir">
        <title>remove the temp file</title>
        <description>Submit script to create the UKO server directory and set dynamic variables</description>
        <runAsUser substitution="true">$!{instance-UKO_ADMIN_SERVER}</runAsUser>
        <approver substitution="true">$!{instance-UKO_APPROVER_SERVER}</approver>
        <instructions substitution="true">Submit shell script to execute step</instructions>
        <weight>1</weight>
        <autoEnable>true</autoEnable>
        <template>
            <inlineTemplate substitution="true">
            
                #Remove temporary file
                rm ${instance-TEMP_DIR}/zosmf-cert-${_workflow-softwareServiceInstanceName}.properties
                

            </inlineTemplate>
            <submitAs>shell-JCL</submitAs>
        </template>
    </step>

</workflow>