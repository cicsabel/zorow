<workflow xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../workflow/schemas/workflow_v1.xsd">
    <!--  Note: The schema workflow_v1.xsd is shipped with z/OSMF. To use the schema
          to validate this XML, modify the above schema location to point to the 
          schema in z/OSMF, or copy the schema to an appropriate location.  -->

    <!--++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
    <!-- Virtual Sysprog : Start ACSP                                         -->
    <!--++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-->

  <workflowInfo>
      <workflowID>acsp_Start</workflowID>
      <workflowDescription>Start ACSP.</workflowDescription>
    <workflowVersion>1.0.0.0</workflowVersion>
        <!-- Build timestamp 2021.05.09.21.03.24 -->
      <vendor>IBM</vendor>
      <Provisioning>
          <productID>5655-EKM</productID>
          <productName>ACSP</productName>
          <productVersion>V2R1+</productVersion>
          <softwareType>ACSP</softwareType>
      </Provisioning>
  </workflowInfo>
  
  	<!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
	<!--     Include variables used by the following steps     -->
	<!--+++++++++++++++++++++++++++++++++++++++++++++++++++++++-->
	&variables;
	
	
    <!--+++++++++++++++++++++++-->
    <!--   Start ACSP    -->
    <!--+++++++++++++++++++++++-->  
    <step name="startAcsp">
        <title>Start ACSP</title>
        <description>Start ACSP</description>

        <step name="checkIfAcspAlreadyRunning" optional="false">
            <title>Check if server running</title>
            <description>Check whether ACSP is running already</description>
            <runAsUser substitution="true">$!{instance-UKO_ADMIN_CONSOLE}</runAsUser>
            <approver substitution="true">$!{instance-UKO_APPROVER_CONSOLE}</approver>
            <instructions>Execute console API to check ACSP is running already</instructions>
            <weight>1</weight>
            <skills>z/OS administration</skills>
            <autoEnable>true</autoEnable>
            <rest>
                <httpMethod>PUT</httpMethod>
                <uriPath substitution="true">/zosmf/restconsoles/consoles/defcn</uriPath>
                <requestBody substitution="true">
                    { 
                      "cmd" : "d a,ACSP",
                      "sol-key" : "NOT FOUND",
                      "system" : "${_workflow-systemName}"
                      
                    }
                </requestBody>
                <expectedStatusCode>200</expectedStatusCode>
                <propertyMapping mapTo="ACSP_REST_STATUS">["sol-key-detected"]</propertyMapping>
            </rest>
        </step>

        <step name="startAcsp_console">
        	<title>Start ACSP from console</title>
        	<description>Start ACSP from the console</description>
        	<runAsUser substitution="true">$!{instance-UKO_ADMIN_CONSOLE}</runAsUser>
	        <approver substitution="true">$!{instance-UKO_APPROVER_CONSOLE}</approver>
            <condition>
                <expression><![CDATA["1" == "1"]]></expression>
                <description>Should the step be executed based on the ACSP_REST_STATUS setting</description>
                <targetStateSet>
                    <description>Check to see whether this step should be skipped</description>
                    <extendStateExpression>
                        <description>Only execute it ACSP_REST_STATUS is not detected</description>
                        <expression><![CDATA[ ${instance-ACSP_REST_STATUS} == "false"]]></expression>
                        <targetState>Skipped</targetState>
                    </extendStateExpression>
                </targetStateSet>
            </condition>
     		<instructions substitution="false">Submitting script to start ACSP.</instructions>
        	<weight>1</weight>
        	<autoEnable>true</autoEnable>
        	<rest>
				<httpMethod>PUT</httpMethod>
				<uriPath substitution="true">/zosmf/restconsoles/consoles/defcn</uriPath>
				<requestBody substitution="true">
				  {
				    "cmd" : "START ACSP",
				    "unsol-key" : "AZH11510I ACSP Server is waiting for commands",
				    "unsol-detect-sync" : "Y",
				    "unsol-detect-timeout" : "30",
				    "detect-time" : "30",
				    "system" : "${_workflow-systemName}"
				    
				  }	
				</requestBody>
				<expectedStatusCode>200</expectedStatusCode>
				<propertyMapping mapTo="ACSP_REST_STATUS">["status"]</propertyMapping>
			</rest>
    	</step>

    	<step name="CheckStartup" optional="false">
            <title>Checking the rest status from the start command</title>
            <description>Check the REST Status from the start command</description>
            <prereqStep name="startAcsp_console"/>
            <runAsUser substitution="true">$!{instance-UKO_ADMIN_TSO}</runAsUser>
            <approver substitution="true">$!{instance-UKO_APPROVER_TSO}</approver>
            <condition>
                <expression><![CDATA[${startAcsp_console.stepState} == "Complete" || ${startAcsp_console.stepState} == "Skipped"]]></expression>
                <description>Should the step be executed based on the ACSP_REST_STATUS setting</description>
                <targetStateSet>
                    <description>Check to see whether this step should be skipped</description>
                    <extendStateExpression>
                        <description>Only execute it ACSP_REST_STATUS is not detected</description>
                        <expression><![CDATA[ ${instance-ACSP_REST_STATUS} == "detected"]]></expression>
                        <targetState>Skipped</targetState>
                    </extendStateExpression>
                    <extendStateExpression>
                        <description>Skip if server was already running</description>
                      <expression><![CDATA[ ${startAcsp_console.stepState} == "Skipped"]]></expression>
                        <targetState>Skipped</targetState>
                    </extendStateExpression>
             </targetStateSet>
            </condition>
            <instructions>Execute simple Rexx command to always return a bad returncode</instructions>
            <weight>1</weight>
            <autoEnable>true</autoEnable>
            <template>
                <inlineTemplate substitution="true">
                    exit 8
                </inlineTemplate>
                <submitAs maxRc="0">TSO-REXX-JCL</submitAs>
            </template>
        </step>
    </step>

</workflow>
